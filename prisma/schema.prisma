generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Literature ───────────────────────────────────────────────────────────────

model Work {
  id               Int      @id @default(autoincrement())
  title            String
  subtitle         String?
  author           String
  yearPublished    Int
  language         String
  originalLanguage String?  // populated when the work is a translation
  translator       String?
  region           String
  country          String
  genre            String
  era              String
  description      String
  significance     String?
  coverImageUrl    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accessLinks  AccessLink[]
  collections  CollectionWork[]
  themes       WorkTheme[]
  relatedFrom  WorkRelation[]   @relation("WorkRelationFrom")
  relatedTo    WorkRelation[]   @relation("WorkRelationTo")
  readingLists ReadingListWork[]
}

model AccessLink {
  id     Int    @id @default(autoincrement())
  url    String
  // web | pdf | archive | publisher | library
  type   String @default("web")
  workId Int
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
}

// Themes are cross-cutting concepts (e.g. "decolonization", "feminism", "identity")
// that cut across region, era, and genre boundaries.
model Theme {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  slug  String      @unique
  works WorkTheme[]
}

model WorkTheme {
  workId  Int
  themeId Int
  work    Work  @relation(fields: [workId], references: [id], onDelete: Cascade)
  theme   Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([workId, themeId])
}

// Directed relationships between works.
// type values: influenced_by | responds_to | same_series | same_movement | companion
model WorkRelation {
  id         Int    @id @default(autoincrement())
  fromWorkId Int
  toWorkId   Int
  type       String
  fromWork   Work   @relation("WorkRelationFrom", fields: [fromWorkId], references: [id], onDelete: Cascade)
  toWork     Work   @relation("WorkRelationTo", fields: [toWorkId], references: [id], onDelete: Cascade)

  @@unique([fromWorkId, toWorkId, type])
}

// Curated reading paths (e.g. "Intro to African Feminism", "Negritude Movement")
model ReadingList {
  id          Int             @id @default(autoincrement())
  title       String
  slug        String          @unique
  description String
  curatedBy   String          @default("Alexandria")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  works       ReadingListWork[]
}

model ReadingListWork {
  readingListId Int
  workId        Int
  position      Int
  note          String?       // optional context note for this work in this list
  readingList   ReadingList   @relation(fields: [readingListId], references: [id], onDelete: Cascade)
  work          Work          @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([readingListId, workId])
  @@index([readingListId, position])
}

// ─── Authentication ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  collections Collection[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLink {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── User Collections ─────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  works CollectionWork[]
}

model CollectionWork {
  id           String     @id @default(cuid())
  collectionId String
  workId       Int
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([collectionId, workId])
}
