# Supabase Database Connection
# Get these from: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Client
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# JWT Secret for Magic Link Auth (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here"

# App URL (for magic link emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouter API (for Ask Alexandria AI chat)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
# Optional: override the default model (default: anthropic/claude-sonnet-4-6)
# Cheaper alternatives: anthropic/claude-haiku-4-5, google/gemini-flash-1.5
# OPENROUTER_MODEL="anthropic/claude-haiku-4-5"

# Email Provider (optional - for sending magic links)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASS="your-password"
